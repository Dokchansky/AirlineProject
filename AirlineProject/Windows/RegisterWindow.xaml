<Window x:Class="AirlineProject.Windows.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AirlineProject.Windows"
        mc:Ignorable="d"
        Title="Регистрация" Height="433" Width="330"
        ResizeMode="NoResize"
WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Height="176" Margin="65,81,0,0" Width="211"  >
            <Image Source="samolet.jpg" Width="178"/>
        </StackPanel>
        
        <StackPanel Width="180" Margin="75,10,75,230">
            <Label Content="Фамилия" />
            <TextBox x:Name="user_surname"/>
            <Label Content="Имя"/>
            <TextBox x:Name="user_name"/>
            <Label Content="Отчество"/>
            <TextBox x:Name="user_patronymic" />
        </StackPanel>
        <StackPanel Margin="75,192,75,151" Width="180">
            <Label Content="Логин"/>
            <TextBox x:Name="loginbox"/>
        </StackPanel>
        <StackPanel Margin="76,250,74,89" Width="180">
            <Label Content="Пароль"/>
            <PasswordBox x:Name="passwordbox"/>
        </StackPanel>
        <StackPanel Height="51" VerticalAlignment="Top" Margin="0,328,0,0" >
            <Button x:Name="registerbutton" Click="registerbutton_Click" Content="Регистрация" Height="32" FontSize="14" FontFamily="Gill Sans Ultra Bold Condensed"  Width="131" Style="{DynamicResource MaterialDesignRaisedButton}"/>
        </StackPanel>
    </Grid>
</Window>
