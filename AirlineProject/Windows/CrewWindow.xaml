<Window x:Class="AirlineProject.Windows.CrewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AirlineProject.Windows"
        mc:Ignorable="d"
        Title="CrewWindow" Height="450" Width="800">
    <Grid>
        <DataGrid Margin="21,72,135,102" x:Name="CrewGrid" AutoGenerateColumns="False" CanUserResizeColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Фамилия" CanUserReorder="False"/>
                <DataGridTextColumn Header="Имя" CanUserReorder="False"/>
                <DataGridTextColumn Header="Отчество" CanUserReorder="False"/>
                <DataGridTextColumn Header="Домашний адрес" CanUserReorder="False"/>
                <DataGridTextColumn Header="Домашний телефон" CanUserReorder="False"/>

            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Margin="305,368,-305,-368">
            <Button x:Name="exitbutton" Click="exitbutton_Click" Content="Выход" Width="100" FontSize="16" FontFamily="Gill Sans Ultra Bold Condensed" Style="{DynamicResource MaterialDesignRaisedButton}"/>
        </StackPanel>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,37,0,0">
            <TextBlock Text="Информация о экипаже" Foreground="BlueViolet" FontSize="15" FontFamily="Gill Sans Ultra Bold Condensed"/>
        </StackPanel>
    </Grid>
</Window>
