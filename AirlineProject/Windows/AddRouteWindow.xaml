<Window x:Class="AirlineProject.Windows.AddRouteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AirlineProject.Windows" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Добавление рейса" Height="533" Width="330"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Height="176" Margin="65,81,0,0" Width="211"  >
            <Image Source="samolet.jpg" Width="178"/>
        </StackPanel>
        <StackPanel Margin="75,10,64,127">
            <Label Content="Номер рейса" />
            <TextBox x:Name="number_Route"/>
            <Label Content="Направление"/>
            <TextBox x:Name="direction_Route"/>
            <Label Content="Первый пилот"/>
            <ComboBox x:Name="first_pilot" />
            <Label Content="Второй пилот" />
            <ComboBox x:Name="second_pilot"  />
            <Label Content="Стюардесса"/>
            <ComboBox x:Name="stew_ardess"  />
            <Label Content="Дата вылета"/>
            <DatePicker x:Name="DateDeparture"/>
            <Label Content="Время вылета"/>
            <TextBox x:Name="timeDeparture"/>
        </StackPanel>
        <StackPanel Height="51" VerticalAlignment="Top" Margin="0,415,0,0" >
            <Button x:Name="registerbutton" Click="addbutton_Click" Content="Добавить" Height="32" FontSize="14" FontFamily="Gill Sans Ultra Bold Condensed"  Width="131" Style="{DynamicResource MaterialDesignRaisedButton}"/>
        </StackPanel>
        
    </Grid>
</Window>
