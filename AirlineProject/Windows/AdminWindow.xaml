<Window x:Class="AirlineProject.Windows.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AirlineProject.Windows"
        mc:Ignorable="d"
        Title="Окно администратора" Height="450" Width="800"
        ResizeMode="NoResize"
WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,21,0,0">
            <TextBlock Text="Окно администратора" FontSize="16" Foreground="BlueViolet" FontFamily="Gill Sans Ultra Bold Condensed" />
        </StackPanel>
        <StackPanel Margin="305,357,-305,-357">
            <Button x:Name="exitbutton" Click="exitbutton_Click" Content="Выход" Width="100" FontSize="16" FontFamily="Gill Sans Ultra Bold Condensed" Style="{DynamicResource MaterialDesignRaisedButton}"/>
        </StackPanel>
        <StackPanel Margin="-195,180,195,-180">
            <Button x:Name="flight" Click="flight_Click" Content="Рейс" Width="200" FontSize="16" FontFamily="Gill Sans Ultra Bold Condensed" Style="{DynamicResource MaterialDesignRaisedButton}"/>
        </StackPanel>
        <StackPanel Margin="205,180,-205,-180">
            <Button x:Name="crew" Click="crew_Click" Content="Экипаж" Width="200" FontSize="16" FontFamily="Gill Sans Ultra Bold Condensed" Style="{DynamicResource MaterialDesignRaisedButton}"/>
        </StackPanel>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Height="139" Margin="0,40,0,0" Width="172"  >
            <Image Source="image.png" Width="178"/>
        </StackPanel>
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Height="176" Width="211"  >
            <Image Source="samolet.jpg" Width="178" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="-1"/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
        </StackPanel>
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Height="176" Margin="589,0,0,0" Width="211"  >
            <Image Source="samolet.jpg" Width="178"/>
        </StackPanel>
    </Grid>
</Window>
